    "/api/bounties/import": {
      "post": {
        "description": "Admin-only CSV import. Validation failures are reported per data row.",
        "requestBody": {
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "created": {
                      "type": "integer",
                    },
                    "data": {
                      "items": {
                        "properties": {
                          "errors": {
                            "items": {
                              "type": "string",
                            },
                            "type": "array",
                          },
                          "id": {
                            "type": "string",
                          },
                          "row": {
                            "type": "integer",
                          },
                        },
                        "required": [
                          "row",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "failed": {
                      "type": "integer",
                    },
                    "total": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "data",
                    "created",
                    "failed",
                    "total",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Import summary.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Admin authentication required.",
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "A CSV content type is required.",
          },
        },
        "summary": "Import bounties from CSV",
        "tags": [
          "Admin",
        ],
      },
    },
    "/api/bounties/search": {
      "get": {
        "description": "Free-text search across title, repository, and description, ranked in that order.",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/BountyRecord",
                      },
                      "type": "array",
                    },
                    "hasMore": {
                      "type": "boolean",
                    },
                    "page": {
                      "type": "integer",
                    },
                    "pageSize": {
                      "type": "integer",
                    },
                    "total": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "data",
                    "total",
                    "page",
                    "pageSize",
                    "hasMore",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Ranked, paginated search results.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Invalid pagination parameters.",
          },
        },
        "summary": "Search bounties",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/{id}/audit-log": {
      "get": {
        "description": "Returns ordered status transition history for a bounty. Use \`page\` (default 1) and \`pageSize\` (1-100, default 20) for pagination.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "One-based page number.",
              "example": 1,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "description": "Number of audit entries per page (1-100).",
              "example": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BountyAuditLogListResponse",
