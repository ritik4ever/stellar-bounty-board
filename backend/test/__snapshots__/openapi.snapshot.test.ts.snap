  "info": {
    "description": "REST API for the Stellar Bounty Board — a platform for posting, reserving, submitting, and releasing on-chain bounties backed by Stellar tokens.

**Bounty lifecycle:** \`open\` → \`reserved\` → \`submitted\` → \`released\`

Maintainers may \`cancel\` an \`open\` bounty before reservation, or \`refund\` an \`open\` or \`reserved\` bounty after the deadline. Bounties whose deadline passes are automatically transitioned to \`expired\`.",
    "title": "Stellar Bounty Board API",
    "version": "1.0.0",
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/audit-log": {
      "get": {
        "description": "Admin-only endpoint that returns a paginated view of all audit log records. Requires a valid x-admin-api-key header.",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "description": "Maximum number of log records to return (1-200, default 50)",
              "example": 50,
              "maximum": 200,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "description": "Zero-based offset into the audit log list",
              "example": 0,
              "minimum": 0,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "actor",
            "required": false,
            "schema": {
              "description": "Filter logs by actor (Stellar address)",
              "example": "GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "transition",
            "required": false,
            "schema": {
              "description": "Filter logs by transition type",
              "example": "release",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "bountyId",
            "required": false,
            "schema": {
              "description": "Filter logs by bounty ID",
              "example": "BNT-0001",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "fromStatus",
            "required": false,
            "schema": {
              "description": "Filter logs by fromStatus",
              "example": "submitted",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "toStatus",
            "required": false,
            "schema": {
              "description": "Filter logs by toStatus",
              "example": "released",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BountyAuditLogListResponse",
                },
              },
            },
            "description": "Paginated list of audit logs",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Invalid or missing x-admin-api-key header",
          },
        },
        "summary": "List all audit logs (admin-only)",
        "tags": [
          "Admin",
        ],
      },
    },
    "/api/bounties": {
      "get": {
        "description": "Returns bounty records sorted by \`createdAt\` descending by default, with optional maintainer/status/token filters and sort parameters. Bounties whose deadline has passed are automatically transitioned to \`expired\` before the list is returned.",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "Case-insensitive substring filter applied to title, summary, and labels.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "contributor",
            "required": false,
            "schema": {
              "description": "Exact Stellar public key filter applied to the bounty contributor.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "maintainer",
            "required": false,
            "schema": {
              "description": "Exact Stellar public key filter applied to the bounty maintainer.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "description": "Exact bounty status filter. Combines with maintainer and tokenSymbol using AND logic.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "tokenSymbol",
            "required": false,
            "schema": {
              "description": "Exact token symbol filter. Combines with maintainer and status using AND logic.",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "description": "Field to sort by (default: createdAt).",
              "enum": [
                "amount",
                "deadline",
                "createdAt",
                "status",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "description": "Sort direction (default: desc).",
              "enum": [
                "asc",
                "desc",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "deadlineBefore",
            "required": false,
            "schema": {
              "description": "Filter bounties with deadline before this ISO 8601 date string.",
              "example": "2026-08-26T16:01:06.327Z",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "deadlineAfter",
            "required": false,
            "schema": {
              "description": "Filter bounties with deadline after this ISO 8601 date string.",
              "example": "2026-07-27T16:01:06.328Z",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "Page number (starts at 1, default 1).",
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "description": "Number of items per page (max 100, default 20).",
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/BountyRecord",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Array of all bounty records.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Invalid query parameters (e.g., invalid date string, maintainer address, sort field, or order).",
          },
        },
        "summary": "List all bounties",
        "tags": [
          "Bounties",
        ],
      },
      "post": {
        "description": "Creates a new open bounty and persists it. Rate-limited to **5 requests per IP per minute**. The \`deadlineAt\` timestamp is computed as \`now + deadlineDays * 86400\`.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBountyRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BountyRecord",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Bounty created successfully.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Validation failed — see \`error\` field for details.",
          },
        },
        "summary": "Create a bounty",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/:id/cancel": {
      "post": {
        "description": "Cancels an \`open\` bounty before any contributor has reserved it. Transitions the bounty to \`refunded\`, records a \`canceledAt\` timestamp, and returns the full escrow (no fee). Cannot be called on \`reserved\`, \`submitted\`, \`released\`, or already \`refunded\` bounties. Only the maintainer address recorded on the bounty may call this endpoint. Rate-limited to **5 requests per IP per minute**.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintainerActionRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BountyRecord",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Bounty canceled.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty not found, not open, maintainer mismatch, or validation failed.",
          },
        },
        "summary": "Cancel an open bounty",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/:id/notes": {
      "patch": {
        "description": "Updates the maintainer notes for a bounty. Only the maintainer address recorded on the bounty may call this endpoint. Notes are limited to 2000 characters. Rate-limited to **5 requests per IP per minute**.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNotesRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BountyRecord",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Notes updated successfully.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty not found, maintainer mismatch, or validation failed.",
          },
        },
        "summary": "Update bounty notes",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/:id/refund": {
      "post": {
        "description": "Transitions an \`open\` or \`reserved\` bounty to \`refunded\`. Cannot be called on \`submitted\`, \`released\`, or already \`refunded\` bounties. Only the maintainer address recorded on the bounty may call this endpoint. Rate-limited to **5 requests per IP per minute**.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintainerActionRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BountyRecord",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Bounty refunded.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty not found, already finalised, maintainer mismatch, or validation failed.",
          },
        },
        "summary": "Refund a bounty",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/{id}/audit-log": {
      "get": {
        "description": "Returns ordered status transition history for a bounty. Use \`page\` (default 1) and \`pageSize\` (1-100, default 20) for pagination.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "description": "One-based page number.",
              "example": 1,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "description": "Number of audit entries per page (1-100).",
              "example": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BountyAuditLogListResponse",
                },
              },
            },
            "description": "Audit log page for the requested bounty.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty id invalid or pagination query invalid.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty not found.",
          },
        },
        "summary": "List audit logs for one bounty",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/{id}/release": {
      "post": {
        "description": "Transitions a \`submitted\` bounty to \`released\`, indicating payment has been sent. Only the maintainer address recorded on the bounty may call this endpoint. Rate-limited to **5 requests per IP per minute**.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MaintainerActionRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BountyRecord",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Payment released.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty not found, not submitted, maintainer mismatch, or validation failed.",
          },
        },
        "summary": "Release payment for a bounty",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/{id}/reserve": {
      "post": {
        "description": "Assigns a contributor to an \`open\` bounty, transitioning its status to \`reserved\`. Only one contributor can hold a reservation at a time. Rate-limited to **5 requests per IP per minute**.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveBountyRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BountyRecord",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Bounty successfully reserved.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty not found, not open, or validation failed.",
          },
        },
        "summary": "Reserve a bounty",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/bounties/{id}/submit": {
      "post": {
        "description": "Transitions a \`reserved\` bounty to \`submitted\` by attaching a submission URL. The \`contributor\` field must exactly match the address that reserved the bounty. Rate-limited to **5 requests per IP per minute**.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "example": "BNT-0001",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitBountyRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/BountyRecord",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Work submitted successfully.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Bounty not found, not reserved, contributor mismatch, or validation failed.",
          },
        },
        "summary": "Submit work for a bounty",
        "tags": [
          "Bounties",
        ],
      },
    },
    "/api/health": {
      "get": {
        "description": "Returns the service name and current server timestamp. Use this to verify the API is reachable.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse",
                },
              },
            },
            "description": "Service is healthy.",
          },
        },
        "summary": "Health check",
        "tags": [
          "System",
        ],
      },
    },
    "/api/health/deep": {
      "get": {
        "description": "Extended health check that verifies all external dependencies. Checks JSON store read/write, Soroban RPC reachability, contract ID configuration, and auth configuration (MAINTAINER_PUBLIC_KEY and ARBITER_ADDRESS). Excluded from rate limiting. Returns HTTP 503 when any critical component is down.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeepHealthResponse",
                },
              },
            },
            "description": "All critical components are healthy.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeepHealthResponse",
                },
              },
            },
            "description": "One or more critical components are down.",
          },
        },
        "summary": "Deep health check",
        "tags": [
          "System",
        ],
      },
    },
    "/api/leaderboard": {
      "get": {
        "description": "Returns the top 10 contributors ranked by total XLM received from released bounties. Ties are broken by the number of bounties completed. Returns an empty array when no bounties have been released yet.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/LeaderboardEntry",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Top 10 contributors by XLM earned.",
          },
        },
        "summary": "Contributor leaderboard",
        "tags": [
          "Leaderboard",
        ],
      },
    },
    "/api/open-issues": {
      "get": {
        "description": "Returns a curated static list of open feature requests and contribution opportunities for the Stellar Bounty Board project itself.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "$ref": "#/components/schemas/OpenIssue",
                      },
                      "type": "array",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Array of open issues.",
          },
        },
        "summary": "List open feature requests",
        "tags": [
          "Open Issues",
        ],
      },
    },
    "/api/stats": {
      "get": {
        "description": "Returns aggregate statistics for the entire platform including bounty status counts, total funded and released amounts, and unique participant counts. Response is cached with a **30-second TTL** to reduce computation overhead.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/GlobalMetrics",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Global platform metrics.",
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Failed to compute global stats.",
          },
        },
        "summary": "Global platform metrics",
        "tags": [
          "Stats",
        ],
      },
    },
  },
  "servers": [
    {
      "description": "Local development server",
      "url": "http://localhost:3001",
    },
  ],
  "webhooks": {},
}
