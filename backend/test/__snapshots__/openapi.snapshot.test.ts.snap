                        "cadence",
                        "templateId",
                        "targetRepo",
                        "bounty",
                        "active",
                        "createdAt",
                        "nextRunAt",
                        "createdBountyIds",
                      ],
                      "type": "object",
                    },
                  },
                  "required": [
                    "data",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Schedule cancelled.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
            },
            "description": "Admin authentication required.",
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse",
                },
              },
