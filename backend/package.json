{
  "name": "stellar-bounty-board-backend",
  "version": "1.0.0",
  "description": "Backend API for Stellar Bounty Board",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "start": "node dist/index.js",
    "gen:openapi": "tsx src/docs/writeOpenApi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@stellar/stellar-sdk": "^15.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "ioredis": "^5.4.1",
    "pino": "^9.6.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "proper-lockfile": "^4.1.2",
    "stellar-bounty-board": "file:..",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^7.8.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pino": "^7.0.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "prisma": "^7.8.0",
    "supertest": "^7.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
