# .env.example
# PostgreSQL connection string for Prisma
# Example: postgres://username:password@localhost:5432/stellar_bounty
DATABASE_URL=postgresql://username:password@localhost:5432/stellar_bounty

# GitHub token for repository ownership verification
# Required for maintainer repo-ownership check before bounty creation
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Comma-separated list of trusted test repos that bypass ownership verification
# Example: trusted-org/test-repo,another-org/sandbox
TRUSTED_TEST_REPOS=
