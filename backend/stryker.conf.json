{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing configuration scoped to the bountyStore service (issue #901).",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/bountyStore.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/bountyStore.json"
  },
  "mutate": ["src/services/bountyStore.ts"],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 75
  }
}
