# ==============================================================================
# Prettier Ignore Configuration
# ==============================================================================
# This file defines directories and patterns that Prettier should not format.
# Non-obvious and deliberately chosen settings are annotated below to distinguish
# custom repository architecture requirements from standard template defaults.

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
# Third-party code should never be reformatted. Lockfiles are maintained by package
# managers (npm/yarn/pnpm) and reformatting them invalidates structural checksums.
node_modules
package-lock.json
yarn.lock
pnpm-lock.yaml

# ------------------------------------------------------------------------------
# Build Outputs & Generated Artifacts (Deliberately chosen)
# ------------------------------------------------------------------------------
# dist & build contain compiler output from TypeScript/Vite/tsc.
dist
build
# .next & out are reserved for static/hybrid Next.js exports if deployed.
.next
out
# coverage reports contain machine-generated HTML/JSON test metrics from Vitest/c8.
coverage

# Auto-generated Soroban smart contract TypeScript bindings (Deliberately chosen):
# Produced by `bash scripts/gen-bindings.sh`. Reformatting generated files causes
# `npm run check:bindings` to fail in CI due to git diff discrepancies.
frontend/src/generated

# Auto-generated OpenAPI spec (Deliberately chosen):
# Produced by `npm run gen:openapi` via JSON.stringify(..., null, 2). Prettier
# collapses arrays onto single lines, producing churn that no longer matches the
# generator output on every regeneration. Do not reformat.
docs/openapi.generated.json

# OpenAPI registry source (Deliberately chosen):
# Hand-maintained spec definitions written with double quotes; eslint (the CI
# gate) enforces code quality, while reformatting this large file with prettier
# produces unrelated churn. Kept out of prettier to keep diffs focused.
backend/src/docs/openapi.ts

# Cargo compiler artifacts for Soroban contracts (Deliberately chosen):
contracts/target
target

# Snapshot test fixtures (Deliberately chosen):
# Soroban test snapshot files contain verbatim JSON state captures that must not be altered.
contracts/test_snapshots
contracts/**/test_snapshots
*.zip

# Generated OpenAPI artifacts (Deliberately chosen):
# `frontend`-consumed spec and its source are emitted by `npm run gen:openapi`.
# Reformatting them creates churn and breaks the spec drift check
# (`test/openapi.routes.test.ts`), so they are kept byte-for-byte as generated.
backend/src/docs/openapi.ts
docs/openapi.generated.json

# ------------------------------------------------------------------------------
# Runtime Data Stores (Deliberately chosen)
# ------------------------------------------------------------------------------
# Local file-based database JSON records mutated at runtime by the backend store
data/*.json
backend/data/*.json

# ------------------------------------------------------------------------------
# Environment & Secrets (Security Sensitive)
# ------------------------------------------------------------------------------
# Local environment overrides should never be staged, modified, or reformatted.
.env
.env.local
.env.*.local

# ------------------------------------------------------------------------------
# Editor & OS Artifacts (Standard Template)
# ------------------------------------------------------------------------------
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# ------------------------------------------------------------------------------
# Runtime Logs & Debugging Output (Standard Template)
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------------------------
# Test & Coverage Caches (Deliberately chosen)
# ------------------------------------------------------------------------------
# nyc/Istanbul instrumented coverage outputs.
.nyc_output

# ------------------------------------------------------------------------------
# Temporary Caches & Build Intermediates (Deliberately chosen)
# ------------------------------------------------------------------------------
# .cache holds compiler cache (e.g. Vite/Babel/Rust bindings cache).
.cache
.temp
tmp
