{
  "frontend/src/**/*.{ts,tsx}": ["prettier --write"],
  "backend/{src,test}/**/*.ts": ["prettier --write"],
  "playwright.config.ts": ["prettier --write"],
  "playwright/**/*.{ts,js}": ["prettier --write"],
  "*.{json,md,yaml,yml}": ["prettier --write"],
  ".coderabbit.yaml": ["prettier --write"],
  ".lintstagedrc.json": ["prettier --write", "node scripts/validate-devops-configs.mjs"],
  "railway.toml": ["node scripts/validate-devops-configs.mjs"],
  "Dockerfile*": ["node scripts/validate-devops-configs.mjs"],
  "docker-compose.yml": ["node scripts/validate-devops-configs.mjs"],
  ".github/workflows/ci.yml": ["node scripts/validate-devops-configs.mjs"],
  ".github/workflows/bindings-drift.yml": ["node scripts/validate-devops-configs.mjs"],
  "*.sol": ["forge fmt"],
  "*.rs": ["rustfmt"]
}
