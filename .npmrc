# ==============================================================================
# NPM Runtime Configuration (.npmrc)
# ==============================================================================
# Architectural Overview & Deviations from Tool Defaults
# ==============================================================================
# This configuration file deliberately overrides standard npm package manager
# defaults to maintain reproducible dependency resolution across monorepo workspaces.
#
# ------------------------------------------------------------------------------
# Verified Monorepo Settings & Cross-Check Matrix
# ------------------------------------------------------------------------------
# 1. Setting: legacy-peer-deps=true
#    - npm Tool Default (npm v7+): legacy-peer-deps=false
#      By default, npm automatically attempts to install all peer dependencies and halts
#      with a fatal ERESOLVE error whenever conflicting peer dependency versions are encountered.
#    - Deliberate Deviation: legacy-peer-deps=true (reverting to npm v6 resolution semantics)
#    - Workspace Verification:
#      * root/package.json: devDependencies require React/TypeScript tooling.
#      * backend/package.json: Pinned to @stellar/stellar-sdk ^15.1.0 with differing peer ranges.
#      * frontend/package.json: React 18, Vite, and Soroban client bindings.
#      Cross-checked against `npm ci` in GitHub Actions CI workflows. Reverting to false
#      causes immediate ERESOLVE conflict during monorepo package tree construction.
#
# 2. Setting: fund=false
#    - Suppresses non-actionable funding notices in CI/CD build logs to keep output clean.
# ------------------------------------------------------------------------------

legacy-peer-deps=true
fund=false
