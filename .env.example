# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION & FRAMEWORK DEVIATIONS
# ==============================================================================
# Copy this file to .env and update the values for your local setup.
# IMPORTANT: Never commit the actual .env file to git.
#
# Deliberate Deviations from Framework Defaults:
# - PORT=3001: Standard Express scaffolds default to port 3000. In this monorepo,
#   port 3000 is reserved for the Vite/Next frontend server; backend is moved to 3001.
# - BOUNTY_STORE_PATH=./data/bounties.json: File-backed JSON store replaces standard
#   RDBMS defaults, enabling frictionless zero-dependency local startup.
# - GITHUB_WEBHOOK_SECRET: Non-blocking in development mode to allow frontend and
#   Soroban contract development without requiring an active ngrok/webhook tunnel.
# - SOROBAN_RPC_URL: Points to Futurenet (https://rpc-futurenet.stellar.org)
#   instead of Mainnet to allow free testnet transactions and faucet testing.
# - Dual-Tier Rate Limits (120 Reads vs 10 Mutations / min): Replaces flat rate
#   limits to support frequent frontend UI polling while defending state changes.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------------------------------------------

# [REQUIRED] The port the backend server will listen on.
PORT=3001

# [REQUIRED] Secret used to verify signatures for GitHub Webhooks.
# This is critical for security - it prevents attackers from sending fake webhook events.
# Generate a random string: openssl rand -hex 20
# In production, this MUST be set or the application will refuse to start.
# In development, a warning is logged if missing, but the app continues.
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# [REQUIRED] Local file path for the bounty data store JSON.
BOUNTY_STORE_PATH=./data/bounties.json

# [REQUIRED] Local file path for the audit logs data store JSON.
BOUNTY_AUDIT_STORE_PATH=./data/audit.json

# [OPTIONAL] Defines the environment (e.g., development, test, production).
# Default: development
# NODE_ENV=development

# [OPTIONAL] Production CORS allowlist (comma-separated). Required when NODE_ENV=production.
# Example: ALLOWED_ORIGINS=https://bounty-board.vercel.app
# ALLOWED_ORIGINS=https://bounty-board.vercel.app

# [OPTIONAL] Development CORS origins. Defaults to permissive wildcard (*) when unset.
# Use an explicit list to restrict local dev, e.g. http://localhost:3000 (Vite default port).
# CORS_ORIGINS=*
# CORS_ORIGINS=http://localhost:3000

# [OPTIONAL] Logging level. One of: trace, debug, info, warn, error, fatal, silent.
# Invalid values fall back to "info" with a startup warning. Default: info
LOG_LEVEL=info

# [OPTIONAL] Rate limiting window in milliseconds for both read and mutation limiters.
# Default: 60000 (1 minute)
# RATE_LIMIT_WINDOW_MS=60000

# [OPTIONAL] Maximum requests per window for the read limiter (GET requests, generous).
# Default: 120 requests per window
# RATE_LIMIT_READ_MAX=120

# [OPTIONAL] Maximum requests per window for the mutation limiter (state-changing routes, strict).
# Applied to create, reserve, submit, release, refund, and other mutation endpoints.
# Default: 10 requests per window
# RATE_LIMIT_MUTATION_MAX=10

# [OPTIONAL] Maximum requests per window for POST /api/bounties/:id/reserve (unauthenticated write).
# Reserving acquires the store lock, rewrites persistent state, appends an audit-log entry,
# and fan-outs a maintainer notification; 10/min matches the sibling write routes (submit/release/refund).
# Default: 10 requests per window
# RATE_LIMIT_RESERVE_MAX=10

# [OPTIONAL] Rate limit window in milliseconds for POST /api/bounties/:id/reserve.
# Default: 60000 (1 minute)
# RATE_LIMIT_RESERVE_WINDOW_MS=60000

# [OPTIONAL] Maximum requests per window for GET /api/health (liveness probe, generous).
# The route does no I/O and is polled by load balancers / uptime monitors, so the
# ceiling is deliberately high to avoid false outage signals.
# Default: 300 requests per window
# RATE_LIMIT_HEALTH_MAX=300

# [OPTIONAL] Rate limit window in milliseconds for GET /api/health.
# Default: 60000 (1 minute)
# RATE_LIMIT_HEALTH_WINDOW_MS=60000

# [OPTIONAL] Maximum requests per window for GET /api/health/deep.
# This endpoint probes filesystem reads/writes and the Soroban RPC, so its
# default ceiling is lower than the cheap liveness endpoint.
# Default: 10 requests per window
# RATE_LIMIT_DEEP_HEALTH_MAX=10

# [OPTIONAL] Rate limit window in milliseconds for GET /api/health/deep.
# Default: 60000 (1 minute)
# RATE_LIMIT_DEEP_HEALTH_WINDOW_MS=60000

# [OPTIONAL] Test suite timeout in milliseconds. Extended when running concurrency/stress tests.
# Default: 15000 (15 seconds, matches vitest.config.ts testTimeout)
# TEST_TIMEOUT_MS=15000

# [OPTIONAL] Number of concurrent requests to fire in concurrency tests.
# Tests verify lock mechanisms and race condition handling with this many simultaneous operations.
# Default: 20
# CONCURRENCY_TEST_COUNT=20

# [OPTIONAL] Number of requests to fire in rate-limit stress tests.
# Should be greater than RATE_LIMIT_READ_MAX to verify rate limit enforcement.
# Default: 200
# RATE_LIMIT_TEST_COUNT=200

# [OPTIONAL] Default body size limit for standard routes (Issue #1304).
# Default: 32kb
# DEFAULT_BODY_LIMIT=32kb

# [OPTIONAL] Large body size limit for heavy payloads (Issue #1304).
# Default: 256kb
# LARGE_BODY_LIMIT=256kb

# [OPTIONAL] Idempotency response cache TTL in milliseconds (Issue #1304).
# Default: 600000 (10 minutes)
# IDEMPOTENCY_TTL_MS=600000

# [OPTIONAL] Cleanup sweep interval for expired idempotency entries in milliseconds (Issue #1304).
# Default: 60000 (1 minute)
# IDEMPOTENCY_CLEANUP_INTERVAL_MS=60000

# [OPTIONAL] Maintainer file-lock retry count when writing rate limit records (Issue #1304).
# Default: 5
# MAINTAINER_LOCK_RETRIES=5

# [OPTIONAL] Maintainer file-lock minimum backoff timeout in milliseconds (Issue #1304).
# Default: 10
# MAINTAINER_LOCK_MIN_TIMEOUT_MS=10

# [OPTIONAL] Maintainer file-lock maximum backoff timeout in milliseconds (Issue #1304).
# Default: 50
# MAINTAINER_LOCK_MAX_TIMEOUT_MS=50

# [OPTIONAL] Maintainer file-lock stale threshold in milliseconds (Issue #1304).
# Default: 5000
# MAINTAINER_LOCK_STALE_MS=5000

# [OPTIONAL] Cache TTL in seconds for public bounty list (Issue #1301).
# Default: 5
# BOUNTY_LIST_CACHE_TTL_SECONDS=5

# [OPTIONAL] Cache TTL in seconds for global statistics and metrics (Issue #1301).
# Default: 30
# GLOBAL_METRICS_CACHE_TTL_SECONDS=30

# [OPTIONAL] Cache TTL in milliseconds for open issues discovery feed (Issue #1301).
# Default: 600000 (10 minutes)
# OPEN_ISSUES_CACHE_TTL_MS=600000

# [OPTIONAL] Default target repository for open issue discovery (Issue #1301).
# Default: ritik4ever/stellar-bounty-board
# OPEN_ISSUES_DEFAULT_REPO=ritik4ever/stellar-bounty-board

# [OPTIONAL] Archival background job interval in milliseconds (Issue #1301).
# Default: 86400000 (24 hours)
# ARCHIVE_JOB_INTERVAL_MS=86400000

# [OPTIONAL] Retention window in days before terminal bounties are auto-archived (Issue #1301).
# Default: 90
# ARCHIVE_AFTER_DAYS=90

# [OPTIONAL] Reservation expiration background job interval in milliseconds (Issue #1301).
# Default: 3600000 (1 hour)
# RESERVATION_EXPIRATION_INTERVAL_MS=3600000

# [OPTIONAL] Dispute scanner background job interval in milliseconds (Issue #1301).
# Default: 3600000 (1 hour)
# DISPUTE_ALERT_JOB_INTERVAL_MS=3600000

# [OPTIONAL] Maximum SLA window in hours for resolving disputes before alerting (Issue #1301).
# Default: 72
# DISPUTE_SLA_HOURS=72

# [OPTIONAL] Cooldown in hours between repeat alerts for stuck disputes (Issue #1301).
# Default: 24
# DISPUTE_ALERT_INTERVAL_HOURS=24

# [OPTIONAL] Recurring bounty scheduler interval in milliseconds (Issue #1301).
# Default: 60000 (1 minute)
# RECURRING_SCHEDULER_INTERVAL_MS=60000

# [OPTIONAL] Default pagination page size for list endpoints (Issue #1298).
# Default: 20
# DEFAULT_PAGE_SIZE=20

# [OPTIONAL] Maximum allowed pagination limit for list endpoints (Issue #1298).
# Default: 100
# MAX_PAGE_SIZE=100

# [OPTIONAL] Default ranking limit for leaderboard query (Issue #1298).
# Default: 10
# DEFAULT_LEADERBOARD_LIMIT=10

# [OPTIONAL] Maximum payload size for CSV batch imports (Issue #1298).
# Default: 1mb
# CSV_UPLOAD_LIMIT=1mb

# [OPTIONAL] Maximum payload size for raw request body capture and webhooks (Issue #1298).
# Default: 256kb
# RAW_BODY_LIMIT=256kb

# [OPTIONAL] Cache-Control max-age in seconds for open issues feed (Issue #1298).
# Default: 600 (10 minutes)
# OPEN_ISSUES_CACHE_SECONDS=600

# [OPTIONAL] Cache-Control max-age in seconds for public bounties board (Issue #1298).
# Default: 5 (5 seconds)
# BOUNTIES_LIST_CACHE_SECONDS=5

# [OPTIONAL] Cache-Control max-age in seconds for public config endpoint (Issue #1298).
# Default: 300 (5 minutes)
# CONFIG_CACHE_SECONDS=300

# [OPTIONAL] Cache-Control stale-while-revalidate in seconds for config endpoint (Issue #1298).
# Default: 60 (1 minute)
# CONFIG_STALE_WHILE_REVALIDATE_SECONDS=60


# [OPTIONAL] Bcrypt hash of the admin API key used to access GET /api/audit-log.
# Generate with: node scripts/hash-admin-key.js <your-admin-key>
# If absent, the server will log a warning on startup and the endpoint returns 500.
ADMIN_API_KEY_HASH=

# [REQUIRED for disputes] Stellar public key of the trusted arbiter account.
# The arbiter is the only address authorised to call `dispute_bounty` on the contract.
# It is set during contract initialisation (the `arbiter` argument to `initialize`).
# If absent, the /api/health/deep endpoint will report components.auth as "down".
# Example: ARBITER_ADDRESS=GARBITER...XXXXXXXXXXXXXXXXXXXX
ARBITER_ADDRESS=

# [REQUIRED for deep health] Stellar public key used to verify maintainer signatures.
# Also accepts MAINTAINER_PUBLIC_KEYS (comma-separated) for multiple maintainers.
MAINTAINER_PUBLIC_KEY=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF


# ------------------------------------------------------------------------------
# WORKER CONFIGURATION (SOROBAN)
# ------------------------------------------------------------------------------

# [REQUIRED] The Soroban Smart Contract ID to index events from.
# Find this after deploying your contract.
SOROBAN_CONTRACT_ID=CCXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [OPTIONAL] The RPC endpoint for the Stellar/Soroban network.
# Default: https://rpc-futurenet.stellar.org
SOROBAN_RPC_URL=https://rpc-futurenet.stellar.org

# [OPTIONAL] How frequently the worker polls for new events (in seconds).
# Default: 10
SOROBAN_POLL_INTERVAL=10

# [OPTIONAL] Attempts per poll (with exponential backoff) before the indexer
# gives up until the next poll. Whole number >= 1.
# Default: 5
SOROBAN_INDEXER_MAX_RETRIES=5

# [OPTIONAL] Delay before the first retry, in milliseconds; doubles on each
# further attempt.
# Default: 1000
SOROBAN_INDEXER_INITIAL_BACKOFF_MS=1000


# ------------------------------------------------------------------------------
# ARCHIVE JOB CONFIGURATION
# ------------------------------------------------------------------------------

# [OPTIONAL] Number of days after a bounty reaches Released or Refunded status
# before it is automatically soft-archived by the background job.
# Archived bounties are excluded from active listings but remain fetchable by ID.
# Default: 90
# ARCHIVE_AFTER_DAYS=90

# [OPTIONAL] How frequently the archive job runs (in milliseconds).
# Default: 86400000 (24 hours)
# ARCHIVE_JOB_INTERVAL_MS=86400000


# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (VITE)
# ------------------------------------------------------------------------------

# [REQUIRED] The base URL for the Backend API.
# For local development, this is usually http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api

# Comma-separated token symbols accepted when creating bounties (defaults to XLM,USDC).
ALLOWED_TOKEN_SYMBOLS=XLM,USDC

# ------------------------------------------------------------------------------
# CONTRACT CONFIG (exposed via GET /api/config — safe, non-sensitive values only)
# ------------------------------------------------------------------------------

# [OPTIONAL] Protocol fee in basis points collected on each bounty release (0 = no fee).
# 100 bps = 1%. Must be 0–10000. Mirrors the protocol_fee_bps argument on the contract.
# Default: 0
# PROTOCOL_FEE_BPS=0

# [OPTIONAL] Seconds that must elapse after a dispute is raised before the arbiter
# can resolve it. Mirrors the dispute_window set during contract initialization.
# Default: 0
# DISPUTE_WINDOW_SECONDS=86400

# [OPTIONAL] Minimum allowed bounty amount in the payment token. Default: 1
# MIN_BOUNTY_AMOUNT=1

# [OPTIONAL] Maximum allowed bounty amount in the payment token. Default: 10000
# MAX_BOUNTY_AMOUNT=10000

# ------------------------------------------------------------------------------
# ADDITIONAL BACKEND CONFIGURATION (operational tuning, notifications, rate limits)
# ------------------------------------------------------------------------------
# These variables were referenced in source code (process.env.*) but were missing
# from this file. They are all OPTIONAL with sensible defaults — included here
# for completeness so a deploy operator can override any of them.

# [OPTIONAL] Node.js keepAliveTimeout in milliseconds (HTTP server).
# Default: 65000
# KEEP_ALIVE_TIMEOUT=65000

# [OPTIONAL] Node.js headersTimeout in milliseconds (HTTP server).
# Must be greater than KEEP_ALIVE_TIMEOUT. Default: 66000
# HEADERS_TIMEOUT=66000

# [OPTIONAL] Stellar network passphrase. Auto-detected from STELLAR_NETWORK if unset.
# SOROBAN_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015

# [OPTIONAL] Stellar network identifier. One of: futurenet, testnet, public.
# Default: futurenet
# STELLAR_NETWORK=futurenet

# [OPTIONAL] File path for the bounty template store (used by template API).
# Default: ./data/bounty-templates.json
# BOUNTY_TEMPLATE_STORE_PATH=./data/bounty-templates.json

# [OPTIONAL] File path for the recurring bounty store.
# Default: ./data/recurring-bounties.json
# RECURRING_BOUNTY_STORE_PATH=./data/recurring-bounties.json

# [OPTIONAL] File path for the push notification subscription store.
# Default: ./data/push-subscriptions.json
# PUSH_SUBSCRIPTION_STORE_PATH=./data/push-subscriptions.json

# [OPTIONAL] File path for the maintainer rate-limit counter store.
# Default: ./data/maintainer-rate-limits.json
# MAINTAINER_RATE_LIMIT_STORE_PATH=./data/maintainer-rate-limits.json

# [OPTIONAL] Store lock timeout in milliseconds (prevents concurrent writes).
# Default: 5000
# STORE_LOCK_TIMEOUT_MS=5000

# [OPTIONAL] Redis connection URL for distributed rate-limiting/cache.
# When unset, the backend falls back to in-memory stores (single-instance only).
# REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# NOTIFICATION CONFIGURATION (email + webhook)
# ------------------------------------------------------------------------------

# [OPTIONAL] Email address to receive admin alerts (failed webhooks, etc.).
# ADMIN_ALERT_EMAIL=admin@example.com

# [OPTIONAL] SendGrid API key for sending notification emails.
# SENDGRID_API_KEY=

# [OPTIONAL] "From" email address used when sending via SendGrid.
# SENDGRID_FROM_EMAIL=noreply@example.com

# [OPTIONAL] Notification channel name (used for logging/metrics).
# Default: webhook
# NOTIFICATION_CHANNEL=webhook

# [OPTIONAL] Outbound webhook URL for cross-system notifications.
# NOTIFICATION_WEBHOOK_URL=

# [OPTIONAL] Secret for signing outbound notification webhook payloads.
# NOTIFICATION_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# MAINTAINER-SPECIFIC RATE LIMITING
# ------------------------------------------------------------------------------

# [OPTIONAL] Max bounties a single maintainer can create per window.
# Default: 50
# MAINTAINER_BOUNTY_RATE_LIMIT=50

# [OPTIONAL] Window (ms) for the maintainer bounty creation rate limit.
# Default: 3600000 (1 hour)
# MAINTAINER_BOUNTY_RATE_WINDOW_MS=3600000

# [OPTIONAL] Comma-separated list of maintainer public keys (alternative to
# MAINTAINER_PUBLIC_KEY for multi-maintainer setups).
# MAINTAINER_PUBLIC_KEYS=GAAAA...,GBBBB...

# ------------------------------------------------------------------------------
# DISPUTE / SLA CONFIGURATION
# ------------------------------------------------------------------------------

# [OPTIONAL] Hours within which a dispute must be resolved (SLA tracking).
# Default: 72
# DISPUTE_SLA_HOURS=72

# [OPTIONAL] How frequently the dispute alert job runs (in hours).
# Default: 6
# DISPUTE_ALERT_INTERVAL_HOURS=6

# [OPTIONAL] Seconds that must elapse after a dispute is raised before the
# arbiter can resolve it. Mirrors the dispute_window set during contract init.
# Default: 86400 (24 hours)
# DISPUTE_WINDOW_SECONDS=86400

# [OPTIONAL] Number of days a contributor has to submit work after reserving
# a bounty before it auto-expires. Mirrors the reservation_ttl contract arg.
# Default: 7
# RESERVATION_TTL_DAYS=7

# ------------------------------------------------------------------------------
# CONTRACT / TOKEN CONFIGURATION
# ------------------------------------------------------------------------------

# [OPTIONAL] Contract ID alias (alternative to SOROBAN_CONTRACT_ID).
# CONTRACT_ID=

# [OPTIONAL] Native Stellar token address (XLM).
# TOKEN_ADDR_STELLAR=

# [OPTIONAL] JSON map of token symbol → contract address.
# Example: TOKEN_ADDRESS_MAP={"XLM":"...","USDC":"..."}
# TOKEN_ADDRESS_MAP=

# ------------------------------------------------------------------------------
# FRONTEND / CORS ADDITIONAL CONFIG
# ------------------------------------------------------------------------------

# [OPTIONAL] Frontend URL (used for email notifications and CORS allowlist).
# FRONTEND_URL=http://localhost:3000

# [OPTIONAL] GitHub token used by the backend to read public bounty issues
# from external repos (for the "open issues" discovery endpoint).
# GITHUB_TOKEN=

# [OPTIONAL] Repo (owner/name) to scan for open bounty issues.
# Example: OPEN_ISSUES_REPO=ritik4ever/stellar-bounty-board
# OPEN_ISSUES_REPO=

# ------------------------------------------------------------------------------
# WEBHOOK DEDUPLICATION CACHE
# ------------------------------------------------------------------------------

# [OPTIONAL] TTL in seconds for the webhook PR cache (avoids reprocessing same PR).
# Default: 3600
# WEBHOOK_PR_CACHE_TTL_SECONDS=3600

# [OPTIONAL] TTL in milliseconds for the webhook dedup store.
# Default: 86400000 (24 hours)
# WEBHOOK_DEDUP_TTL_MS=86400000

# [OPTIONAL] Cleanup interval (ms) for expired webhook dedup entries.
# Default: 3600000 (1 hour)
# WEBHOOK_DEDUP_CLEANUP_INTERVAL_MS=3600000
